{
  "name": "ytsearch.js",
  "version": "2.1.3",
  "description": "TypeScript YouTube search and data library for Node.js. Search videos, channels, playlists, movies, and live streams, fetch video details and paginated playlist items, without the YouTube Data API.",
  "main": "dist/main.js",
  "module": "dist/main.mjs",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "require": "./dist/main.js",
      "import": "./dist/main.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/main.ts --format cjs,esm --dts --dts-resolve --out-dir dist --clean --splitting",
    "clean": "rm -rf dist",
    "prepare": "npm run clean && npm run build",
    "test": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/rjryt"
  },
  "keywords": [
    "ytsearch.js",
    "ytsearch",
    "youtube-search",
    "youtube-scraper",
    "youtube-search-api",
    "youtube-video-search",
    "youtube-channel-search",
    "youtube-playlist",
    "youtube-playlist-items",
    "youtube-playlist-pagination",
    "youtube-video-details",
    "youtube-metadata",
    "youtube-api-wrapper",
    "youtube-data-api-alternative",
    "youtube",
    "nodejs",
    "typescript"
  ],
  "dependencies": {
    "axios": "^1.12.0"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "jest": "^30.1.3",
    "tsup": "^8.5.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RJRYT/ytsearch.js.git"
  },
  "author": "RJRYT <robinjratr@gmail.com> (https://rjryt.github.io/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RJRYT/ytsearch.js/issues"
  },
  "homepage": "https://github.com/RJRYT/ytsearch.js#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
